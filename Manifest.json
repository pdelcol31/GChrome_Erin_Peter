{
  "manifest_version": 3,
  "name": "Test",
  "description": "",
  "version": "0.0.1",
  "background": {
    "service_worker": "background.js"
  }
  "permissions": [
    "tabs",
    "pageCapture",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ]
  "icon": {
    "16": "smiley_face16.jpg",
    "48": "smiley_face48.jpg",
    "128": "smiley_face128.jpg"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
  
  
