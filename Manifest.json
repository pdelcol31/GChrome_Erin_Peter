{
  "name": "Chat chrome extension",
  "description": "Tokenize ChatGPT for inputs",
  "version": "1.0",
  "manifest_version": 3,
  "action" : {
    "default_popup": "popup.html"
  },
  "background":{
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
