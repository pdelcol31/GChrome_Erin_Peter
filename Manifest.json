{
  "name": "Chat chrome extension",
  "description": "Tokenize ChatGPT for inputs",
  "version": "1.0",
  "manifest_version": 3,
  "background":{
    "service_worker": "dist/background.bundle.js",
    "type": "module" 
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*",
  "http://localhost:8000/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"]
  }]
}
