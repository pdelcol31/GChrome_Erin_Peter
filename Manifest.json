{
  "name": "Chat chrome extension",
  "description": "Tokenize ChatGPT for inputs",
  "version": "1.0",
  "manifest_version": 3,
  "background":{
    "service_worker": "dist/background.bundle.js",
    "type": "module" 
  },
  "permissions": ["activeTab", "scripting", "geolocation", "storage"],
  "host_permissions": ["http://gptfootprint.cs.haverford.edu/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["Pennsylvania_County_Boundaries.geojson"],
      "matches": ["<all_urls>"]
  }]
}
